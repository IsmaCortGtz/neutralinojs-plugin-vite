{
  "applicationId": "js.neutralino.vite",
  "version": "1.0.0",
  "defaultMode": "window",
  "documentRoot": "/vite-src/dist/",
  "url": "/",
  "enableServer": true,
  "enableNativeAPI": true,
  "nativeAllowList": [
    "app.*",
    "os.*",
    "debug.log"
  ],
  "modes": {
    "window": {
      "title": "myapp",
      "width": 800,
      "height": 500,
      "minWidth": 400,
      "minHeight": 200,
      "center": true,
      "icon": "/vite-src/public/vite.svg",
      "enableInspector": true,
      "openInspectorOnStartup": false,
      "resizable": true,
      "exitProcessOnClose": true
    }
  },
  "cli": {
    "binaryName": "myapp",
    "resourcesPath": "/vite-src/dist/",
    "extensionsPath": "/extensions/",
    "vite": {
      "projectPath": "/vite-src/"
    }
  }
}